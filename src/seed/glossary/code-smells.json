        {
          "label": "Long Parameter List on refactoring.guru",
          "url": "https://refactoring.guru/smells/long-parameter-list"
        }
      ]
    },
    {
      "id": "data-clumps",
      "title": "Data Clumps",
      "category": "Code Smells",
      "group": "Bloaters",
      "summary": "The same group of values always travels together (start/end dates, lat/lng, street/city/zip).",
      "signs": [
        "Identical parameter groups across methods",
        "Fields that are only meaningful together"
      ],
      "related": [
        "extract-class",
        "introduce-parameter-object",
        "preserve-whole-object"
      ],
      "links": [
