    "url": "https://refactoring.guru/refactoring/smells"
  },
  "entries": [
    {
      "id": "long-method",
      "title": "Long Method",
      "category": "Code Smells",
      "group": "Bloaters",
      "summary": "A method has grown so long it's hard to understand, test or reuse.",
      "signs": [
        "You scroll to read it",
        "Comments separate 'sections' inside it",
        "Many local variables"
      ],
      "related": [
        "extract-method",
        "replace-temp-with-query",
        "introduce-parameter-object",
        "decompose-conditional"
      ],
      "links": [
        {
          "label": "Long Method on refactoring.guru",
          "url": "https://refactoring.guru/smells/long-method"
        }
      ]
    },
    {
      "id": "large-class",
      "title": "Large Class",
      "category": "Code Smells",
      "group": "Bloaters",
      "summary": "A class tries to do too much: too many fields, methods and responsibilities.",
      "signs": [
        "Many unrelated fields",
        "Methods cluster into separate groups",
        "Frequent merge conflicts in one file"
      ],
      "related": [
        "extract-class",
        "extract-subclass",
        "extract-interface"
      ],
      "links": [
        {
          "label": "Large Class on refactoring.guru",
          "url": "https://refactoring.guru/smells/large-class"
        }
      ]
    },
    {
      "id": "primitive-obsession",
      "title": "Primitive Obsession",
      "category": "Code Smells",
      "group": "Bloaters",
      "summary": "Domain concepts (money, email, phone, status) are passed around as raw strings and numbers.",
      "signs": [
        "Validation of the same value repeated everywhere",
        "Constants used as type codes",
        "Arrays used as records"
      ],
      "related": [
        "replace-data-value-with-object",
        "replace-type-code-with-class",
        "replace-array-with-object",
        "introduce-parameter-object"
