{
  "id": "code-smells",
  "title": "Code Smells",
  "description": "Signs that code may need refactoring, grouped as on refactoring.guru. Each lists typical refactorings to apply.",
  "groups": [
    "Bloaters",
    "Object-Orientation Abusers",
    "Change Preventers",
    "Dispensables",
    "Couplers"
  ],
